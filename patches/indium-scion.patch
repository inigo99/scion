+uint32_t Indium::PrivateDevice::bindlessAlloc(int kind) {
+	if (!bindlessSet) return 0;
+	std::lock_guard lock(bindlessMutex);
+	if (!bindlessFree[kind].empty()) { auto i = bindlessFree[kind].back(); bindlessFree[kind].pop_back(); return i; }
