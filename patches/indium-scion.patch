+// scion: Private memory is device-local when the GPU has it (discrete GPUs list system memory types too); Managed and
+// Shared need host-visible memory, Shared also coherent, in the first such type. Never AMD device-coherent/uncached types
+// (they need a feature that is not enabled) or protected memory.
+size_t Indium::PrivateDevice::memoryTypeFor(uint32_t typeBits, StorageMode mode) {
+	const auto& props = memoryProperties();
+	size_t fallback = SIZE_MAX;
+	for (uint32_t i = 0; i < props.memoryTypeCount; ++i) {
+		auto f = props.memoryTypes[i].propertyFlags;
+		if (!(typeBits & (1u << i)) || (f & (VK_MEMORY_PROPERTY_PROTECTED_BIT | VK_MEMORY_PROPERTY_DEVICE_COHERENT_BIT_AMD | VK_MEMORY_PROPERTY_DEVICE_UNCACHED_BIT_AMD))) continue;
+		if (mode == StorageMode::Private || mode == StorageMode::Memoryless) {
+			if (f & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) return i;
+			if (fallback == SIZE_MAX) fallback = i;
+			continue;
+		}
+		if (!(f & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) || (mode == StorageMode::Shared && !(f & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT))) continue;
+		return i;
+	}
+	return fallback;
