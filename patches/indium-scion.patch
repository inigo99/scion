+// Vulkan only accepts 16-bit fragment/vertex outputs with the storageInputOutput16 feature, which many drivers lack:
+// declare half-typed outputs as 32-bit floats and convert on store (Metal's half4 returns are very common).
+static Iridium::SPIRV::ResultID widenedOutputType(Iridium::SPIRV::Builder& builder, LLVMTypeRef llvmType) {
+	using namespace Iridium::SPIRV;
+	auto kind = DynamicLLVM::LLVMGetTypeKind(llvmType);
+	if (kind == LLVMHalfTypeKind) {
+		return builder.declareType(Type(Type::FloatTag {}, 32));
+	}
+	if (kind == LLVMVectorTypeKind && DynamicLLVM::LLVMGetTypeKind(DynamicLLVM::LLVMGetElementType(llvmType)) == LLVMHalfTypeKind) {
+		auto f32 = Type(Type::FloatTag {}, 32);
+		auto f32ID = builder.declareType(f32);
+		auto n = DynamicLLVM::LLVMGetVectorSize(llvmType);
+		return builder.declareType(Type(Type::VectorTag {}, n, f32ID, f32.size * n, ((n == 3 || n == 4) ? 4 : 2) * f32.alignment));
+	}
+	return ResultIDInvalid;
+};
