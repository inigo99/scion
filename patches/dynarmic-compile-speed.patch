+template<typename Gen>
+void (*A64EmitX64::EmitFallback(Gen gen))() {
+    const auto resume = code.getCurr();
+    code.SetCodePtr(fallback_cur);
+    code.align();
+    const auto entry = code.getCurr<void (*)()>();
+    gen();
+    fallback_cur = code.getCurr<u8*>();
+    ASSERT_MSG(fallback_cur <= fallback_end, "fastmem fallback area exhausted");
+    code.SetCodePtr(resume);
+    return entry;
+}
+
+void (*A64EmitX64::ReadFallback(bool ordered, size_t bitsize, int vaddr_idx, int value_idx))() {
+    const auto key = std::make_tuple(ordered, bitsize, vaddr_idx, value_idx);
+    if (const auto it = read_fallbacks.find(key); it != read_fallbacks.end()) {
+        return it->second;
+    }
+    const auto fn = EmitFallback([&] {
+        if (bitsize == 128) {
+            ABI_PushCallerSaveRegistersAndAdjustStackExcept(code, HostLocXmmIdx(value_idx));
+            if (vaddr_idx != code.ABI_PARAM2.getIdx()) {
+                code.mov(code.ABI_PARAM2, Xbyak::Reg64{vaddr_idx});
+            }
+            if (ordered) {
+                code.mfence();
+            }
+            code.call(memory_read_128);
+            if (value_idx != 1) {
+                code.movaps(Xbyak::Xmm{value_idx}, xmm1);
             }
+            ABI_PopCallerSaveRegistersAndAdjustStackExcept(code, HostLocXmmIdx(value_idx));
+            code.ret();
+            return;
+        }
+        ABI_PushCallerSaveRegistersAndAdjustStackExcept(code, HostLocRegIdx(value_idx));
+        if (vaddr_idx != code.ABI_PARAM2.getIdx()) {
+            code.mov(code.ABI_PARAM2, Xbyak::Reg64{vaddr_idx});
+        }
+        if (ordered) {
+            code.mfence();
+        }
+        switch (bitsize) {
+        case 8: Devirtualize<&A64::UserCallbacks::MemoryRead8>(conf.callbacks).EmitCall(code); break;
+        case 16: Devirtualize<&A64::UserCallbacks::MemoryRead16>(conf.callbacks).EmitCall(code); break;
+        case 32: Devirtualize<&A64::UserCallbacks::MemoryRead32>(conf.callbacks).EmitCall(code); break;
+        default: Devirtualize<&A64::UserCallbacks::MemoryRead64>(conf.callbacks).EmitCall(code); break;
+        }
+        if (value_idx != code.ABI_RETURN.getIdx()) {
+            code.mov(Xbyak::Reg64{value_idx}, code.ABI_RETURN);
+        }
+        ABI_PopCallerSaveRegistersAndAdjustStackExcept(code, HostLocRegIdx(value_idx));
+        code.ZeroExtendFrom(bitsize, Xbyak::Reg64{value_idx});
+        code.ret();
+    });
+    read_fallbacks.emplace(key, fn);
+    return fn;
+}
+
+/* the value and the address go to ABI_PARAM3 and ABI_PARAM2, whichever registers they are in */
+static void MoveAddressAndValue(BlockOfCode& code, int vaddr_idx, int value_idx) {
+    if (vaddr_idx == code.ABI_PARAM3.getIdx() && value_idx == code.ABI_PARAM2.getIdx()) {
+        code.xchg(code.ABI_PARAM2, code.ABI_PARAM3);
+    } else if (vaddr_idx == code.ABI_PARAM3.getIdx()) {
+        code.mov(code.ABI_PARAM2, Xbyak::Reg64{vaddr_idx});
+        if (value_idx != code.ABI_PARAM3.getIdx()) {
+            code.mov(code.ABI_PARAM3, Xbyak::Reg64{value_idx});
+        }
+    } else {
+        if (value_idx != code.ABI_PARAM3.getIdx()) {
+            code.mov(code.ABI_PARAM3, Xbyak::Reg64{value_idx});
+        }
+        if (vaddr_idx != code.ABI_PARAM2.getIdx()) {
+            code.mov(code.ABI_PARAM2, Xbyak::Reg64{vaddr_idx});
+        }
+    }
+}
 
