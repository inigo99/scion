+void (*A64EmitX64::WriteFallback(bool ordered, size_t bitsize, int vaddr_idx, int value_idx))() {
+    const auto key = std::make_tuple(ordered, bitsize, vaddr_idx, value_idx);
+    if (const auto it = write_fallbacks.find(key); it != write_fallbacks.end()) {
+        return it->second;
+    }
+    const auto fn = EmitFallback([&] {
+        ABI_PushCallerSaveRegistersAndAdjustStack(code);
+        if (bitsize == 128) {
+            if (vaddr_idx != code.ABI_PARAM2.getIdx()) {
+                code.mov(code.ABI_PARAM2, Xbyak::Reg64{vaddr_idx});
+            }
+            if (value_idx != 1) {
+                code.movaps(xmm1, Xbyak::Xmm{value_idx});
             }
+            code.call(memory_write_128);
+        } else {
+            MoveAddressAndValue(code, vaddr_idx, value_idx);
+            code.ZeroExtendFrom(bitsize, code.ABI_PARAM3);
+            switch (bitsize) {
+            case 8: Devirtualize<&A64::UserCallbacks::MemoryWrite8>(conf.callbacks).EmitCall(code); break;
+            case 16: Devirtualize<&A64::UserCallbacks::MemoryWrite16>(conf.callbacks).EmitCall(code); break;
+            case 32: Devirtualize<&A64::UserCallbacks::MemoryWrite32>(conf.callbacks).EmitCall(code); break;
+            default: Devirtualize<&A64::UserCallbacks::MemoryWrite64>(conf.callbacks).EmitCall(code); break;
+            }
+        }
+        if (ordered) {
+            code.mfence();
         }
+        ABI_PopCallerSaveRegistersAndAdjustStack(code);
+        code.ret();
+    });
+    write_fallbacks.emplace(key, fn);
+    return fn;
+}
+
+void (*A64EmitX64::ExclusiveWriteFallback(bool ordered, size_t bitsize, int vaddr_idx, int value_idx))() {
+    const auto key = std::make_tuple(ordered, bitsize, vaddr_idx, value_idx);
+    if (const auto it = exclusive_write_fallbacks.find(key); it != exclusive_write_fallbacks.end()) {
+        return it->second;
     }
+    const auto fn = EmitFallback([&] {
+        ABI_PushCallerSaveRegistersAndAdjustStackExcept(code, HostLoc::RAX);
+        if (bitsize == 128) {
+            if (value_idx != 1) {
+                code.movaps(xmm1, Xbyak::Xmm{value_idx});
+            }
+            if (code.HasHostFeature(HostFeature::SSE41)) {
+                code.movq(xmm2, rax);
+                code.pinsrq(xmm2, rdx, 1);
+            } else {
+                code.movq(xmm2, rax);
+                code.movq(xmm0, rdx);
+                code.punpcklqdq(xmm2, xmm0);
+            }
+            if (vaddr_idx != code.ABI_PARAM2.getIdx()) {
+                code.mov(code.ABI_PARAM2, Xbyak::Reg64{vaddr_idx});
+            }
+            code.call(memory_exclusive_write_128);
+        } else {
+            MoveAddressAndValue(code, vaddr_idx, value_idx);
+            code.ZeroExtendFrom(bitsize, code.ABI_PARAM3);
+            code.mov(code.ABI_PARAM4, rax);
+            code.ZeroExtendFrom(bitsize, code.ABI_PARAM4);
+            switch (bitsize) {
+            case 8: Devirtualize<&A64::UserCallbacks::MemoryWriteExclusive8>(conf.callbacks).EmitCall(code); break;
+            case 16: Devirtualize<&A64::UserCallbacks::MemoryWriteExclusive16>(conf.callbacks).EmitCall(code); break;
+            case 32: Devirtualize<&A64::UserCallbacks::MemoryWriteExclusive32>(conf.callbacks).EmitCall(code); break;
+            default: Devirtualize<&A64::UserCallbacks::MemoryWriteExclusive64>(conf.callbacks).EmitCall(code); break;
+            }
+        }
+        ABI_PopCallerSaveRegistersAndAdjustStackExcept(code, HostLoc::RAX);
+        code.ret();
+    });
+    exclusive_write_fallbacks.emplace(key, fn);
+    return fn;
 }
 
