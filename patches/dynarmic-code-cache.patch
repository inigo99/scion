+/* This file is part of the dynarmic project.
+ * SPDX-License-Identifier: 0BSD
+ */
+
+#pragma once
+
+#include <atomic>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <unordered_map>
+#include <vector>
+
+#include <mcl/stdint.hpp>
+
+#include "dynarmic/backend/x64/emit_x64.h"
+
+namespace Dynarmic::Backend::X64 {
+
+/// A translated block in a form any JIT with the same configuration can relocate into its own code: the host code, and
+/// what in it refers to things outside the block (code in the prelude, constants, fastmem fallbacks, the host
+/// executable, per-JIT pointers), patch locations (block links) and fastmem fault information.
+struct CachedBlock {
+    u64 location;            // IR::LocationDescriptor
+    u64 pc;
+    std::vector<u32> guest;  // the guest instructions it was translated from
+    u64 processor_id;        // of the JIT that compiled it (exclusive monitor slots are relative to it)
+    std::vector<u8> code;
+
+    enum class Kind : u8 {
+        // rel32 fields
+        RelPrelude,   // prelude symbol a (A64EmitX64::CacheSymbols::prelude)
+        RelConst,     // the constant (a, b)
+        RelFallback,  // the fastmem fallback with FallbackKey a
+        RelImage,     // the host executable + a
+        RelAbs,       // the absolute address a (valid in this process only)
+        // imm64 fields
+        ImmConf,
+        ImmCallbacks,
+        ImmTpidr,
+        ImmTpidrro,
+        ImmMonitorLock,
+        ImmMonitorAddress,  // exclusive monitor slot a
+        ImmMonitorValue,
+        ImmImage,
+    };
+    static bool IsRel(Kind k) { return k <= Kind::RelAbs; }
+
+    struct Reloc {
+        u32 at;
+        Kind kind;
+        u8 tail;  // rel32: bytes from the end of the field to the end of the instruction
+        u64 a = 0, b = 0;
+    };
+    std::vector<Reloc> relocs;
+
+    struct Patch {
+        u32 at;
+        PatchKind kind;
+        u64 target;
+    };
+    std::vector<Patch> patches;
+
+    struct Fastmem {
+        u32 at, resume;
+        Kind callback_kind;  // RelPrelude or RelFallback
+        u64 callback;
+        u32 inst;
+        bool recompile;
+    };
+    std::vector<Fastmem> fastmem;
+
+    bool process_local = false;  // refers to absolute addresses outside the host executable
+
+    size_t Bytes() const {
+        return sizeof(*this) + guest.size() * 4 + code.size() + relocs.size() * sizeof(Reloc)
+             + patches.size() * sizeof(Patch) + fastmem.size() * sizeof(Fastmem);
+    }
+};
+
+}  // namespace Dynarmic::Backend::X64
+
+namespace Dynarmic::A64 {
+
+class CodeCache {
+public:
+    std::shared_ptr<const Backend::X64::CachedBlock> Find(u64 location) const;
+    void Insert(std::shared_ptr<const Backend::X64::CachedBlock> block);
+    /// False if `config` (A64EmitX64::CacheConfig) differs from that of the JITs already using the cache
+    bool Attach(u64 config);
+
+    std::atomic<u64> copied{0}, compiled{0}, stale{0}, uncacheable{0}, verified{0}, mismatches{0};
+    static constexpr size_t max_bytes = 64 * 1024 * 1024;
+
+    mutable std::mutex mutex;
+    std::unordered_map<u64, std::shared_ptr<const Backend::X64::CachedBlock>> blocks;
+    size_t bytes = 0;
+    std::optional<u64> config;
+};
+
+}  // namespace Dynarmic::A64
