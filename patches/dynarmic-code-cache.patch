+/* This file is part of the dynarmic project.
+ * SPDX-License-Identifier: 0BSD
+ */
+
+/* Code cache: a block one JIT has compiled is copied into the code of other JITs (other guest threads) instead of being
+ * compiled again. Each JIT keeps its own code buffer, so nothing changes for code that runs, links or is invalidated
+ * concurrently: only the cache's map is shared.
+ *
+ * After a block is emitted it is captured: every field of it that refers to something outside the block is recorded in
+ * a form another JIT can resolve. Xbyak reports those fields as it emits them (relocHook_): rel32 operands and
+ * rip-relative addresses, which point to prelude code, constants, fastmem fallbacks or the host executable, and the
+ * immediates of mov reg, imm, some of which are this JIT's pointers (its configuration, callbacks, tpidr registers,
+ * exclusive monitor slots). Block links (patch locations) are emitted again by the JIT that installs the copy. A block
+ * that refers to anything else (another block, an unknown address in the code buffer) is not cached.
+ * code_cache_verify checks the fields Xbyak reported against the ones found by decoding the block (Zydis), and each
+ * copy against the block compiled again. */
+
+#include "dynarmic/backend/x64/a64_code_cache.h"
+
+#include <algorithm>
+#include <cstring>
+
+#include <Zydis/Zydis.h>
+#include <fmt/format.h>
+#include <mcl/scope_exit.hpp>
+
+#include "dynarmic/backend/x64/a64_emit_x64.h"
+#include "dynarmic/backend/x64/block_of_code.h"
+#include "dynarmic/backend/x64/exclusive_monitor_friend.h"
+#include "dynarmic/common/variant_util.h"
+#include "dynarmic/frontend/A64/a64_location_descriptor.h"
+#include "dynarmic/interface/exclusive_monitor.h"
+#include "dynarmic/ir/basic_block.h"
+
+#ifdef _WIN32
+#    ifndef NOMINMAX
+#        define NOMINMAX
+#    endif
+#    define WIN32_LEAN_AND_MEAN
+#    include <windows.h>
+extern "C" IMAGE_DOS_HEADER __ImageBase;
+#else
+extern "C" char __executable_start;
+extern "C" char _end;
+#endif
+
+namespace Dynarmic::A64 {
+
+std::shared_ptr<CodeCache> MakeCodeCache() {
+    return std::make_shared<CodeCache>();
+}
+
+std::string CodeCacheStats(const CodeCache& c) {
+    std::lock_guard lock{c.mutex};
+    return fmt::format("{} blocks ({} KB): {} compiled, {} copied, {} stale, {} not cacheable, {} verified, {} differ",
+                       c.blocks.size(), c.bytes / 1024, c.compiled.load(), c.copied.load(), c.stale.load(),
+                       c.uncacheable.load(), c.verified.load(), c.mismatches.load());
+}
+
+std::shared_ptr<const Backend::X64::CachedBlock> CodeCache::Find(u64 location) const {
+    std::lock_guard lock{mutex};
+    const auto it = blocks.find(location);
+    return it == blocks.end() ? nullptr : it->second;
+}
+
+void CodeCache::Insert(std::shared_ptr<const Backend::X64::CachedBlock> block) {
+    std::lock_guard lock{mutex};
+    auto& slot = blocks[block->location];
+    if (slot) {
+        if (slot->guest == block->guest) {
+            return;  // another JIT got there first
+        }
+        bytes -= slot->Bytes();  // the guest code there has changed
+    } else if (bytes + block->Bytes() > max_bytes) {
+        blocks.erase(block->location);
+        return;
+    }
+    bytes += block->Bytes();
+    slot = std::move(block);
+}
+
+bool CodeCache::Attach(u64 cfg) {
+    std::lock_guard lock{mutex};
+    if (!config) {
+        config = cfg;
+    }
+    return *config == cfg;
+}
+
+}  // namespace Dynarmic::A64
+
+namespace Dynarmic::Backend::X64 {
+
+using Kind = CachedBlock::Kind;
+
+struct A64EmitX64::CacheSymbols {
+    std::vector<const void*> prelude;  // id -> address
+    std::unordered_map<const void*, u64> prelude_ids;
+    u64 buf_lo, buf_hi;
+    u64 image_lo, image_hi;
+    u64 conf, callbacks, tpidr, tpidrro;
+    u64 mon_lock = 0, mon_addr = 0, mon_value = 0, mon_addr_stride = 0, mon_value_stride = 0, mon_count = 0;
+};
+
+static size_t PatchSize(PatchKind kind) {
+    switch (kind) {
+    case PatchKind::Jg:
+    case PatchKind::Jz:
+        return 23;
+    case PatchKind::Jmp:
+        return 22;
+    case PatchKind::MovRcx:
+        return 10;
+    }
+    return 0;
+}
+
+// The code also depends on the instructions an Interpret terminal hands to the interpreter (A64MergeInterpretBlocksPass
+// counts how many there are in a row): the end of the guest code the block depends on
+static u64 GuestEnd(const IR::Terminal& t, u64 end) {
+    return Common::VisitVariant<u64>(t, [end](const auto& x) -> u64 {
+        using T = std::decay_t<decltype(x)>;
+        if constexpr (std::is_same_v<T, IR::Term::Interpret>) {
+            const u64 next = A64::LocationDescriptor{x.next}.PC();
+            return next + 4 == end ? next + 4 * x.num_instructions : 0;  // 0: elsewhere, not cached
+        } else if constexpr (std::is_same_v<T, IR::Term::If> || std::is_same_v<T, IR::Term::CheckBit>) {
+            const u64 a = GuestEnd(x.then_, end), b = GuestEnd(x.else_, end);
+            return a && b ? std::max(a, b) : 0;
+        } else if constexpr (std::is_same_v<T, IR::Term::CheckHalt>) {
+            return GuestEnd(x.else_, end);
+        } else {
+            return end;
+        }
+    });
+}
+
+// Exclusive monitor slots are relative to the processor of the JIT that compiled the block: code that skips its own
+// slot (EmitExclusiveTestAndClear) must skip the installing JIT's slot instead, so the two are swapped.
+static u64 SwapSlot(u64 slot, u64 from, u64 to) {
+    return slot == from ? to : slot == to ? from : slot;
+}
+
+u64 A64EmitX64::CacheConfig() const {
+    u64 h = 0xcbf29ce484222325;  // FNV-1a
+    const auto mix = [&h](u64 v) {
+        for (int i = 0; i < 8; i++) {
+            h = (h ^ ((v >> (i * 8)) & 0xff)) * 0x100000001b3;
+        }
+    };
+    mix(1);  // format
+    mix(static_cast<u64>(code.HostFeatures()));
+    mix(static_cast<u64>(conf.optimizations));
+    mix(conf.unsafe_optimizations);
+    mix(conf.hook_data_cache_operations);
+    mix(conf.hook_isb);
+    mix(conf.hook_hint_instructions);
+    mix(conf.cntfrq_el0);
+    mix(conf.ctr_el0);
+    mix(conf.dczid_el0);
+    mix(conf.tpidrro_el0 != nullptr);
+    mix(conf.tpidr_el0 != nullptr);
+    mix(conf.page_table != nullptr);
+    mix(conf.page_table_address_space_bits);
+    mix(static_cast<u64>(conf.page_table_pointer_mask_bits));
+    mix(conf.silently_mirror_page_table);
+    mix(conf.absolute_offset_page_table);
+    mix(conf.detect_misaligned_access_via_page_table);
+    mix(conf.only_detect_misalignment_via_page_table_on_page_boundary);
+    mix(conf.fastmem_pointer.has_value());
+    mix(conf.fastmem_pointer.value_or(0));
+    mix(conf.recompile_on_fastmem_failure);
+    mix(conf.fastmem_address_space_bits);
+    mix(conf.silently_mirror_fastmem);
+    mix(conf.fastmem_exclusive_access);
+    mix(conf.recompile_on_exclusive_fastmem_failure);
+    mix(conf.define_unpredictable_behaviour);
+    mix(conf.wall_clock_cntpct);
+    mix(conf.check_halt_on_memory_access);
+    mix(conf.enable_cycle_counting);
+    mix(conf.very_verbose_debugging_output);
+    mix(conf.global_monitor ? GetExclusiveMonitorProcessorCount(conf.global_monitor) : 0);
+    return h;
+}
+
+const A64EmitX64::CacheSymbols& A64EmitX64::Symbols() {
+    if (cache_symbols) {
+        return *cache_symbols;
+    }
+    auto s = std::make_shared<CacheSymbols>();
+    for (const void* p : code.GetReturnFromRunCodeAddresses()) {
+        s->prelude.push_back(p);
+    }
+    for (const void* p : {terminal_handler_pop_rsb_hint, terminal_handler_fast_dispatch_hint,
+                          reinterpret_cast<const void*>(memory_read_128), reinterpret_cast<const void*>(memory_write_128),
+                          reinterpret_cast<const void*>(memory_exclusive_write_128)}) {
+        s->prelude.push_back(p);
+    }
+    for (size_t i = 0; i < s->prelude.size(); i++) {
+        if (s->prelude[i]) {
+            s->prelude_ids.emplace(s->prelude[i], i);
+        }
+    }
+    s->buf_lo = reinterpret_cast<u64>(code.getCode());
+    s->buf_hi = s->buf_lo + code.GetTotalCodeSize();
+#ifdef _WIN32
+    const auto* nt = reinterpret_cast<const IMAGE_NT_HEADERS*>(reinterpret_cast<const u8*>(&__ImageBase) + __ImageBase.e_lfanew);
+    s->image_lo = reinterpret_cast<u64>(&__ImageBase);
+    s->image_hi = s->image_lo + nt->OptionalHeader.SizeOfImage;
+#else
+    s->image_lo = reinterpret_cast<u64>(&__executable_start);
+    s->image_hi = reinterpret_cast<u64>(&_end);
+#endif
+    s->conf = reinterpret_cast<u64>(&conf);
+    s->callbacks = reinterpret_cast<u64>(conf.callbacks);
+    s->tpidr = reinterpret_cast<u64>(conf.tpidr_el0);
+    s->tpidrro = reinterpret_cast<u64>(conf.tpidrro_el0);
+    if (auto* m = conf.global_monitor) {
+        s->mon_lock = reinterpret_cast<u64>(GetExclusiveMonitorLockPointer(m));
+        s->mon_count = GetExclusiveMonitorProcessorCount(m);
+        s->mon_addr = reinterpret_cast<u64>(GetExclusiveMonitorAddressPointer(m, 0));
+        s->mon_value = reinterpret_cast<u64>(GetExclusiveMonitorValuePointer(m, 0));
+        s->mon_addr_stride = sizeof(*GetExclusiveMonitorAddressPointer(m, 0));
+        s->mon_value_stride = sizeof(*GetExclusiveMonitorValuePointer(m, 0));
+    }
+    cache_symbols = s;
+    return *s;
+}
+
+void (*A64EmitX64::FallbackFromKey(u64 key))() {
+    const bool ordered = (key >> 8) & 1;
+    const size_t bitsize = (key >> 16) & 0xffff;
+    const int vaddr_idx = (key >> 32) & 0xff, value_idx = (key >> 40) & 0xff;
+    switch (key & 0xff) {
+    case 0:
+        return ReadFallback(ordered, bitsize, vaddr_idx, value_idx);
+    case 1:
+        return WriteFallback(ordered, bitsize, vaddr_idx, value_idx);
+    case 2:
+        return ExclusiveWriteFallback(ordered, bitsize, vaddr_idx, value_idx);
+    }
+    return nullptr;
+}
+
+bool A64EmitX64::CanCache(IR::LocationDescriptor location) const {
+    // a block that has hit a fastmem fault is compiled without fastmem there: that version stays in this JIT
+    const auto it = do_not_fastmem.lower_bound(DoNotFastmemMarker{location, 0});
+    return it == do_not_fastmem.end() || std::get<0>(*it) != location;
+}
+
+// The fields of a block that hold addresses (rel32, rip-relative) and immediates, found by decoding it: code_cache_verify
+// checks the ones Xbyak reports (relocHook_) against these
+static bool Disassemble(const u8* entry, size_t size, const std::vector<CachedBlock::Patch>& patches, std::vector<CodeField>& fields) {
+    ZydisDecoder decoder;
+    ZydisDecoderInit(&decoder, ZYDIS_MACHINE_MODE_LONG_64, ZYDIS_STACK_WIDTH_64);
+    ZydisDecoderEnableMode(&decoder, ZYDIS_DECODER_MODE_MINIMAL, ZYAN_TRUE);  // lengths and raw fields are enough
+    size_t off = 0, next_site = 0;
+    while (off < size) {
+        if (next_site < patches.size() && patches[next_site].at == off) {
+            off += PatchSize(patches[next_site++].kind);
+            continue;
+        }
+        ZydisDecoderContext ctx;
+        ZydisDecodedInstruction ins;
+        if (ZYAN_FAILED(ZydisDecoderDecodeInstruction(&decoder, &ctx, entry + off, size - off, &ins))
+            || (next_site < patches.size() && off + ins.length > patches[next_site].at)) {
+            return false;
+        }
+        const u64 next = reinterpret_cast<u64>(entry) + off + ins.length;
+        if (ins.attributes & ZYDIS_ATTRIB_IS_RELATIVE) {  // a relative branch, or a rip-relative memory operand
+            u8 field, bits;
+            u64 raw;
+            if (ins.raw.imm[0].is_relative) {
+                field = ins.raw.imm[0].offset;
+                bits = ins.raw.imm[0].size;
+                raw = ins.raw.imm[0].value.u;
+            } else if (ins.raw.disp.size && ins.raw.modrm.mod == 0 && ins.raw.modrm.rm == 5) {
+                field = ins.raw.disp.offset;
+                bits = ins.raw.disp.size;
+                raw = u64(ins.raw.disp.value);
+            } else {
+                return false;
+            }
+            const u64 target = next + u64(s64(raw << (64 - bits)) >> (64 - bits));
+            fields.push_back({u32(off + field), u8(bits / 8), CodeField::Rel, u8(ins.length - field - bits / 8), target});
+        }
+        for (const auto& imm : ins.raw.imm) {
+            if (imm.size >= 32 && !imm.is_relative) {
+                fields.push_back({u32(off + imm.offset), u8(imm.size / 8), CodeField::Imm, 0, imm.value.u});
+            }
+        }
+        off += ins.length;
+    }
+    return next_site == patches.size();
+}
+
+std::shared_ptr<CachedBlock> A64EmitX64::Capture(const IR::Block& block, BlockDescriptor desc, bool disassemble) {
+    const auto& s = Symbols();
+    const u64 pc = A64::LocationDescriptor{block.Location()}.PC();
+    const u64 end = GuestEnd(block.GetTerminal(), A64::LocationDescriptor{block.EndLocation()}.PC());
+    if (end <= pc || end - pc > 0x10000 || (end - pc) % 4) {
+        return nullptr;
+    }
+
+    auto b = std::make_shared<CachedBlock>();
+    b->location = block.Location().Value();
+    b->pc = pc;
+    b->processor_id = conf.processor_id;
+    for (u64 va = pc; va < end; va += 4) {
+        const auto inst = conf.callbacks->MemoryReadCode(va);
+        if (!inst) {
+            return nullptr;
+        }
+        b->guest.push_back(*inst);
+    }
+    const u8* const entry = static_cast<const u8*>(desc.entrypoint);
+    const size_t size = desc.size;
+    const u64 lo = reinterpret_cast<u64>(entry), hi = lo + size;
+    b->code.assign(entry, entry + size);
+
+    auto sites = patch_sites;
+    std::sort(sites.begin(), sites.end(), [](const auto& x, const auto& y) { return x.at < y.at; });
+    for (const auto& p : sites) {
+        const u64 at = reinterpret_cast<u64>(p.at);
+        if (at < lo || at + PatchSize(p.kind) > hi) {
+            return nullptr;
+        }
+        b->patches.push_back({u32(at - lo), p.kind, p.target});
+    }
+
+    // a pointer into this JIT's code, outside the block
+    const auto code_symbol = [&](u64 p, Kind& kind, u64& x, u64& y) {
+        const void* ptr = reinterpret_cast<const void*>(p);
+        if (const auto it = s.prelude_ids.find(ptr); it != s.prelude_ids.end()) {
+            kind = Kind::RelPrelude;
+            x = it->second;
+            return true;
+        }
+        if (code.FindConst(ptr, x, y)) {
+            kind = Kind::RelConst;
+            return true;
+        }
+        if (const auto it = fallback_keys.find(ptr); it != fallback_keys.end()) {
+            kind = Kind::RelFallback;
+            x = it->second;
+            return true;
+        }
+        return false;
+    };
+    // a 64-bit value that is one of this JIT's pointers or in the host executable
+    const auto pointer_symbol = [&](u64 v, Kind& kind, u64& x) {
+        if (v == 0) {
+            return false;
+        }
+        x = 0;
+        if (v == s.conf) {
+            kind = Kind::ImmConf;
+        } else if (v == s.callbacks) {
+            kind = Kind::ImmCallbacks;
+        } else if (v == s.tpidr) {
+            kind = Kind::ImmTpidr;
+        } else if (v == s.tpidrro) {
+            kind = Kind::ImmTpidrro;
+        } else if (v == s.mon_lock) {
+            kind = Kind::ImmMonitorLock;
+        } else if (s.mon_count && v >= s.mon_addr && v < s.mon_addr + s.mon_count * s.mon_addr_stride) {
+            kind = Kind::ImmMonitorAddress;
+            x = (v - s.mon_addr) / s.mon_addr_stride;
+        } else if (s.mon_count && v >= s.mon_value && v < s.mon_value + s.mon_count * s.mon_value_stride) {
+            kind = Kind::ImmMonitorValue;
+            x = (v - s.mon_value) / s.mon_value_stride;
+        } else if (v >= s.image_lo && v < s.image_hi) {
+            kind = Kind::ImmImage;
+            x = v - s.image_lo;
+        } else {
+            return false;
+        }
+        return true;
+    };
+    const auto in_buffer = [&](u64 v) { return v >= s.buf_lo && v < s.buf_hi; };
+
+    for (const u64 at : fastmem_sites) {
+        const auto& info = fastmem_patch_info.at(at);
+        CachedBlock::Fastmem f{u32(at - lo), 0, {}, 0, u32(std::get<1>(info.marker)), info.recompile};
+        u64 unused;
+        if (at < lo || at >= hi || info.resume_rip < lo || info.resume_rip >= hi || std::get<0>(info.marker) != block.Location()
+            || !code_symbol(info.callback, f.callback_kind, f.callback, unused)) {
+            return nullptr;
+        }
+        f.resume = u32(info.resume_rip - lo);
+        b->fastmem.push_back(f);
+    }
+
+    // the fields that hold an address or an immediate: as Xbyak emitted them, or (to check those) by decoding the code
+    std::vector<CodeField> fields;
+    if (!disassemble) {
+        const u64 base = reinterpret_cast<u64>(code.getCode());
+        for (const auto& f : code_fields) {
+            const u64 at = base + f.at;
+            if (at >= lo && at < hi) {
+                fields.push_back({u32(at - lo), f.size, f.kind, f.tail, f.value});
+            }
+        }
+    } else if (!Disassemble(entry, size, b->patches, fields)) {
+        return nullptr;
+    }
+
+    for (const auto& f : fields) {
+        if (std::any_of(b->patches.begin(), b->patches.end(), [&](const auto& p) { return f.at >= p.at && f.at < p.at + PatchSize(p.kind); })) {
+            continue;  // emitted again by the JIT that installs the block
+        }
+        if (f.kind == CodeField::Rel) {
+            if (f.value >= lo && f.value < hi) {
+                continue;  // moves with the block
+            }
+            if (f.size != 4) {
+                return nullptr;
+            }
+            CachedBlock::Reloc r{f.at, Kind::RelAbs, f.tail};
+            if (in_buffer(f.value)) {
+                if (!code_symbol(f.value, r.kind, r.a, r.b)) {
+                    return nullptr;  // another block, or something this cache does not know
+                }
+            } else if (f.value >= s.image_lo && f.value < s.image_hi) {
+                r.kind = Kind::RelImage;
+                r.a = f.value - s.image_lo;
+            } else {
+                r.a = f.value;
+                b->process_local = true;
+            }
+            b->relocs.push_back(r);
+            continue;
+        }
+        Kind kind;
+        u64 x;
+        if (f.size == 8) {
+            if (in_buffer(f.value)) {
+                return nullptr;
+            }
+            if (pointer_symbol(f.value, kind, x)) {
+                b->relocs.push_back({f.at, kind, 0, x});
+            }
+            continue;
+        }
+        // a pointer in a 32-bit immediate cannot be relocated to an arbitrary one
+        const u64 zext = f.value & 0xFFFF'FFFF, sext = u64(s64(s32(u32(zext))));
+        for (const u64 v : {zext, sext}) {
+            if (in_buffer(v) || pointer_symbol(v, kind, x)) {
+                return nullptr;
+            }
+        }
+    }
+    std::sort(b->relocs.begin(), b->relocs.end(), [](const auto& x, const auto& y) { return x.at < y.at; });
+    return b;
+}
+
+std::optional<EmitX64::BlockDescriptor> A64EmitX64::Install(const CachedBlock& b, IR::LocationDescriptor location) {
+    for (size_t i = 0; i < b.guest.size(); i++) {
+        const auto inst = conf.callbacks->MemoryReadCode(b.pc + 4 * i);
+        if (!inst || *inst != b.guest[i]) {
+            return std::nullopt;
+        }
+    }
+    const auto& s = Symbols();
+    code.EnableWriting();
+    SCOPE_EXIT {
+        code.DisableWriting();
+    };
+
+    const auto resolve = [&](Kind kind, u64 x, u64 y) -> u64 {
+        switch (kind) {
+        case Kind::RelPrelude:
+            return x < s.prelude.size() ? reinterpret_cast<u64>(s.prelude[x]) : 0;
+        case Kind::RelConst:
+            return reinterpret_cast<u64>(code.ConstPtr(x, y));
+        case Kind::RelFallback:
+            return reinterpret_cast<u64>(FallbackFromKey(x));
+        case Kind::RelImage:
+        case Kind::ImmImage:
+            return s.image_lo + x;
+        case Kind::RelAbs:
+            return x;
+        case Kind::ImmConf:
+            return s.conf;
+        case Kind::ImmCallbacks:
+            return s.callbacks;
+        case Kind::ImmTpidr:
+            return s.tpidr;
+        case Kind::ImmTpidrro:
+            return s.tpidrro;
+        case Kind::ImmMonitorLock:
+            return s.mon_lock;
+        case Kind::ImmMonitorAddress:
+        case Kind::ImmMonitorValue: {
+            const u64 slot = SwapSlot(x, b.processor_id, conf.processor_id);
+            if (slot >= s.mon_count) {
+                return 0;
+            }
+            return kind == Kind::ImmMonitorAddress ? s.mon_addr + slot * s.mon_addr_stride : s.mon_value + slot * s.mon_value_stride;
+        }
+        }
+        return 0;
+    };
+    std::vector<u64> values;
+    values.reserve(b.relocs.size());
+    for (const auto& r : b.relocs) {
+        values.push_back(resolve(r.kind, r.a, r.b));
+        if (!values.back()) {
+            return std::nullopt;
+        }
+    }
+    std::vector<u64> callbacks;
+    for (const auto& f : b.fastmem) {
+        callbacks.push_back(resolve(f.callback_kind, f.callback, 0));
+        if (!callbacks.back()) {
+            return std::nullopt;
+        }
+    }
+
+    const size_t size = b.code.size();
+    code.EnsureMemoryCommitted(size + 64);
+    code.align();
+    u8* const entry = code.getCurr<u8*>();
+    if (code.SpaceRemaining() < size + 64) {
+        return std::nullopt;
+    }
+    std::memcpy(entry, b.code.data(), size);
+    for (size_t i = 0; i < b.relocs.size(); i++) {
+        const auto& r = b.relocs[i];
+        u8* const field = entry + r.at;
+        if (CachedBlock::IsRel(r.kind)) {
+            const s64 disp = s64(values[i] - reinterpret_cast<u64>(field + 4 + r.tail));
+            if (disp != s64(s32(disp))) {
+                return std::nullopt;  // out of rel32 range from here
+            }
+            const s32 d = s32(disp);
+            std::memcpy(field, &d, 4);
+        } else {
+            std::memcpy(field, &values[i], 8);
+        }
+    }
+
+    for (const auto& p : b.patches) {
+        u8* const at = entry + p.at;
+        const IR::LocationDescriptor target{p.target};
+        const auto next = GetBasicBlock(target);
+        const CodePtr target_code = next ? next->entrypoint : nullptr;
+        auto& info = patch_information[target];
+        code.SetCodePtr(at);
+        switch (p.kind) {
+        case PatchKind::Jg:
+            info.jg.push_back(at);
+            EmitPatchJg(target, target_code);
+            break;
+        case PatchKind::Jz:
+            info.jz.push_back(at);
+            EmitPatchJz(target, target_code);
+            break;
+        case PatchKind::Jmp:
+            info.jmp.push_back(at);
+            EmitPatchJmp(target, target_code);
+            break;
+        case PatchKind::MovRcx:
+            info.mov_rcx.push_back(at);
+            EmitPatchMovRcx(target_code);
+            break;
+        }
+    }
+    code.SetCodePtr(entry + size);
+
+    for (size_t i = 0; i < b.fastmem.size(); i++) {
+        const auto& f = b.fastmem[i];
+        fastmem_patch_info.emplace(reinterpret_cast<u64>(entry + f.at),
+                                   FastmemPatchInfo{reinterpret_cast<u64>(entry + f.resume), callbacks[i],
+                                                    DoNotFastmemMarker{location, f.inst}, f.recompile});
+    }
+    block_ranges.AddRange(boost::icl::discrete_interval<u64>::closed(b.pc, b.pc + 4 * b.guest.size() - 1), location);
+    return RegisterBlock(location, entry, size);
+}
+
+// How a freshly compiled block differs from the cached copy of it (empty: it does not)
+static std::string Diff(const CachedBlock& c, const CachedBlock& f, u64 processor_id) {
+    if (c.guest != f.guest) {
+        return "guest instructions";
+    }
+    if (c.code.size() != f.code.size()) {
+        return fmt::format("size {} vs {}", c.code.size(), f.code.size());
+    }
+    if (c.relocs.size() != f.relocs.size()) {
+        return fmt::format("{} vs {} relocations", c.relocs.size(), f.relocs.size());
+    }
+    std::vector<bool> masked(c.code.size());
+    const auto mask = [&](size_t at, size_t n) {
+        for (size_t i = at; i < at + n && i < masked.size(); i++) {
+            masked[i] = true;
+        }
+    };
+    for (size_t i = 0; i < c.relocs.size(); i++) {
+        auto rc = c.relocs[i];
+        const auto& rf = f.relocs[i];
+        if (rc.kind == Kind::ImmMonitorAddress || rc.kind == Kind::ImmMonitorValue) {
+            rc.a = SwapSlot(rc.a, c.processor_id, processor_id);
+        }
+        if (rc.at != rf.at || rc.kind != rf.kind || rc.tail != rf.tail || rc.a != rf.a || rc.b != rf.b) {
+            return fmt::format("relocation at +{:x}: kind {} a {:x} vs kind {} a {:x} at +{:x}", rc.at, int(rc.kind), rc.a,
+                               int(rf.kind), rf.a, rf.at);
+        }
+        mask(rc.at, CachedBlock::IsRel(rc.kind) ? 4 : 8);
+    }
+    if (c.patches.size() != f.patches.size()) {
+        return "patch locations";
+    }
+    for (size_t i = 0; i < c.patches.size(); i++) {
+        if (c.patches[i].at != f.patches[i].at || c.patches[i].kind != f.patches[i].kind || c.patches[i].target != f.patches[i].target) {
+            return fmt::format("patch location at +{:x}", c.patches[i].at);
+        }
+        mask(c.patches[i].at, PatchSize(c.patches[i].kind));
+    }
+    if (c.fastmem.size() != f.fastmem.size()) {
+        return "fastmem locations";
+    }
+    for (size_t i = 0; i < c.fastmem.size(); i++) {
+        const auto &x = c.fastmem[i], &y = f.fastmem[i];
+        if (x.at != y.at || x.resume != y.resume || x.callback_kind != y.callback_kind || x.callback != y.callback || x.inst != y.inst
+            || x.recompile != y.recompile) {
+            return fmt::format("fastmem location at +{:x}", x.at);
+        }
+    }
+    for (size_t i = 0; i < c.code.size(); i++) {
+        if (!masked[i] && c.code[i] != f.code[i]) {
+            return fmt::format("byte at +{:x}: {:02x} vs {:02x}", i, c.code[i], f.code[i]);
+        }
+    }
+    return {};
+}
+
+std::optional<EmitX64::BlockDescriptor> A64EmitX64::EmitFromCache(IR::LocationDescriptor location) {
+    if (!code_cache || conf.code_cache_selftest || !CanCache(location)) {
+        return std::nullopt;
+    }
+    const auto b = code_cache->Find(location.Value());
+    if (!b) {
+        return std::nullopt;
+    }
+    if (conf.code_cache_verify) {
+        verify_against = b;  // compared with the block CacheBlock captures next
+        return std::nullopt;
+    }
+    const auto desc = Install(*b, location);
+    ++(desc ? code_cache->copied : code_cache->stale);
+    return desc;
+}
+
+EmitX64::BlockDescriptor A64EmitX64::CacheBlock(const IR::Block& block, BlockDescriptor desc) {
+    const auto location = block.Location();
+    const auto cached = std::move(verify_against);
+    verify_against = nullptr;
+    if (!CanCache(location)) {
+        return desc;
+    }
+    const auto b = Capture(block, desc);
+    if (conf.code_cache_verify) {
+        const auto decoded = Capture(block, desc, true);
+        const auto same = [](const auto& x, const auto& y) {
+            return x.at == y.at && x.kind == y.kind && x.tail == y.tail && x.a == y.a && x.b == y.b;
+        };
+        if (bool(b) != bool(decoded)
+            || (b && !std::equal(b->relocs.begin(), b->relocs.end(), decoded->relocs.begin(), decoded->relocs.end(), same))) {
+            ++code_cache->mismatches;
+            fmt::print(stderr, "dynarmic code cache: the relocations Xbyak reported for the block at {:x} differ from the decoded ones\n",
+                       A64::LocationDescriptor{location}.PC());
+        }
+    }
+    if (cached && cached->location == location.Value()) {
+        const std::string diff = !b                      ? "it cannot be cached"
+                               : cached->guest != b->guest ? std::string{}  // the guest code has changed: a stale copy
+                                                           : Diff(*cached, *b, conf.processor_id);
+        ++code_cache->verified;
+        if (!diff.empty()) {
+            ++code_cache->mismatches;
+            fmt::print(stderr, "dynarmic code cache: block at {:x} differs from its cached copy: {}\n", b ? b->pc : 0, diff);
+        }
+        if (!b || cached->guest == b->guest) {
+            return desc;
+        }
+    }
+    if (!b) {
+        ++code_cache->uncacheable;
+        return desc;
+    }
+    ++code_cache->compiled;
+    code_cache->Insert(b);
+    if (conf.code_cache_selftest) {
+        // run the relocated copy instead
+        InvalidateBasicBlocks(tsl::robin_set<IR::LocationDescriptor>{location});
+        if (const auto copy = Install(*b, location)) {
+            return *copy;
+        }
+        fmt::print(stderr, "dynarmic code cache: could not relocate the block at {:x}\n", b->pc);
+        return RegisterBlock(location, desc.entrypoint, desc.size);
+    }
+    return desc;
+}
+
+}  // namespace Dynarmic::Backend::X64
