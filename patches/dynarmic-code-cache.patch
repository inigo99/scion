+#    ifndef NOMINMAX
+#        define NOMINMAX
+#    endif
+#    define WIN32_LEAN_AND_MEAN
+#    include <windows.h>
+extern "C" IMAGE_DOS_HEADER __ImageBase;
+#else
+#    include <fcntl.h>
+#    include <sys/mman.h>
